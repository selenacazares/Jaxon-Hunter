<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<title>SAS Secure Access</title>

<style>
body {
    background: radial-gradient(circle at center, #0a0a0a 0%, #050505 100%);
    color: #00ff9c;
    font-family: "Courier New", monospace;
    margin: 0;
    padding: 20px;
    overflow-x: hidden;
}

/* grain écran */
body::after {
    content: "";
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: url('https://www.transparenttextures.com/patterns/asfalt-dark.png');
    opacity: 0.15;
    pointer-events: none;
}

#terminal {
    max-width: 900px;
    margin: auto;
    position: relative;
}

/* scan */
#terminal::before {
    content: "";
    position: absolute;
    width: 100%;
    height: 2px;
    background: rgba(0, 255, 156, 0.15);
    animation: scan 6s linear infinite;
}

@keyframes scan {
    0% { top: 0; }
    100% { top: 100%; }
}

.line {
    margin: 5px 0;
    text-shadow: 0 0 5px #00ff9c;
}

.menu {
    margin-top: 20px;
}

.menu span {
    display: block;
    cursor: pointer;
}

.menu span:hover {
    color: white;
}

.glitch {
    animation: glitch 0.3s infinite;
}

@keyframes glitch {
    0% { transform: translate(0); }
    20% { transform: translate(-1px, 1px); }
    40% { transform: translate(1px, -1px); }
    60% { transform: translate(-1px, 0); }
    80% { transform: translate(1px, 1px); }
    100% { transform: translate(0); }
}
</style>
</head>

<body>

<div id="terminal"></div>

<script>
const terminal = document.getElementById("terminal");

function typeLine(text, delay = 20) {
    return new Promise(resolve => {
        const line = document.createElement("div");
        line.classList.add("line");
        terminal.appendChild(line);

        let i = 0;
        function typing() {
            if (i < text.length) {
                line.textContent += text.charAt(i);
                i++;
                setTimeout(typing, delay);
            } else {
                resolve();
            }
        }
        typing();
    });
}

async function bootSequence() {
    await typeLine("SAN ANDREAS SECURITY");
    await typeLine("SECURE ACCESS NODE v3.7");
    await typeLine("");
    await typeLine("> INITIALIZING...");
    await typeLine("> CONNECTING...");
    await typeLine("> ENCRYPTION VERIFIED");
    await typeLine("");
    await typeLine("> ACCESS GRANTED");
    await typeLine("> WELCOME, OFFICER");
    await typeLine("");
    await typeLine("> LOADING FILE: GARM");
    showMenu();
}

function showMenu() {
    const menu = document.createElement("div");
    menu.classList.add("menu");

    menu.innerHTML = `
        <span onclick="loadSection('overview')">[1] SUBJECT OVERVIEW</span>
        <span onclick="loadSection('history')">[2] MILITARY HISTORY</span>
        <span onclick="loadSection('incident')">[3] INCIDENT LOG</span>
        <span onclick="loadSection('psy')">[4] PSYCHOLOGICAL ANALYSIS</span>
        <span onclick="loadSection('classified')">[5] CLASSIFIED FILES</span>
    `;

    terminal.appendChild(menu);
}

function clearTerminal() {
    terminal.innerHTML = "";
}

async function loadSection(section) {
    clearTerminal();

    if (section === "overview") {
        await typeLine("NAME: HUNTER, JAXON");
        await typeLine("CALLSIGN: GARM");
        await typeLine("STATUS: ACTIVE – SAS");
        await typeLine("THREAT LEVEL: CONTROLLED");
    }

    if (section === "history") {
        await typeLine("Former operative – classified unit");
        await typeLine("Leadership: CONFIRMED");
        await typeLine("Stress resistance: HIGH");
        await typeLine("Squad cohesion: EXCELLENT");
    }

    if (section === "incident") {
        await typeLine("[OPERATION: ███████]");
        await typeLine("Unit under heavy fire");
        await typeLine("SANTORO: Stayed behind");
        await typeLine("STATUS: KIA");
        await typeLine("");
        await typeLine("> ADDITIONAL DATA DETECTED...");
    }

    if (section === "psy") {
        await typeLine("Behavior shift detected");
        await typeLine("- Increased engagement");
        await typeLine("- Selective obedience");
        await typeLine("");
        await typeLine("Efficiency: +17%");
    }

    if (section === "classified") {
        await typeLine("> ACCESS LEVEL: OMEGA REQUIRED");
        await typeLine("> OVERRIDE ACCEPTED");
        await typeLine("");
        await typeLine("SANTORO: REAPPEARANCE CONFIRMED");
        await typeLine("First recognition: HUNTER");
        await typeLine("");
        await typeLine("“On rentre ensemble… ou pas du tout.”");
        await typeLine("");
        await typeLine("LINKED SUBJECT: FENRIR");

        const glitch = document.createElement("div");
        glitch.textContent = "████████████████████";
        glitch.classList.add("line", "glitch");
        terminal.appendChild(glitch);
    }

    await typeLine("");
    await typeLine("> RETURN TO MENU");
    showMenu();
}

/* glitch aléatoire */
function randomGlitch() {
    if (Math.random() < 0.1) {
        document.body.style.filter = "brightness(1.5)";
        setTimeout(() => {
            document.body.style.filter = "brightness(1)";
        }, 80);
    }
}
setInterval(randomGlitch, 3000);

bootSequence();
</script>

</body>
</html>
